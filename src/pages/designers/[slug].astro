---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pic from '../../components/Pic.astro';
import GownCard from '../../components/GownCard.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import gowns from '../../data/gowns.js';
import { designers } from '../../data/designers.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return designers.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const list = gowns.filter((g) => g.designer === d.slug);
const idx = designers.indexOf(d);
const next = designers[(idx + 1) % designers.length];
const schema = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Designers', item: `${site.url}/designers/` },
    { '@type': 'ListItem', position: 2, name: d.name },
  ],
}];
---
<Base
  title={`${d.name} Wedding Dresses in Michigan`}
  description={`Try on ${d.name} wedding gowns (${d.price}) near Kalamazoo, Michigan. ${list.length} styles in the salon${d.plus ? ', plus sizes available' : ''}.`}
  image={d.hero}
  header="transparent"
  schema={schema}
>
  <PageHero image={d.hero} eyebrow={d.origin} lines={[d.name]} lede={d.line} pos="50% 22%" alt={`${d.name} bridal gown`} />

  <section class="section wrap grid-12 d-intro">
    <div class="di-copy">
      <p class="eyebrow" data-reveal>The house</p>
      <p class="serif d-lead" data-reveal>{d.intro}</p>
      <p class="body-copy" data-reveal style="--d:.15s">{d.note}</p>
    </div>
    <dl class="di-facts" data-reveal style="--d:.2s">
      <div><dt>Origin</dt><dd>{d.origin}</dd></div>
      {d.founded && <div><dt>Founded</dt><dd>{d.founded}</dd></div>}
      <div><dt>Price range</dt><dd>{d.price}</dd></div>
      <div><dt>In the salon</dt><dd>{list.length} gowns</dd></div>
      <div><dt>Sizing</dt><dd>{d.plus ? 'Standard & plus sizes' : 'Standard sizes'}</dd></div>
    </dl>
  </section>

  <section class="d-editorial wrap" aria-hidden="true">
    {d.feature.map((k, i) => <figure class={`media de-${i}`} data-reveal="mask" style={`--d:${i * 0.12}s`}><Pic k={k} alt="" sizes="(min-width: 900px) 33vw, 50vw" pos="50% 20%" /></figure>)}
  </section>

  <section class="section wrap" aria-labelledby="gowns-title">
    <div class="g-head">
      <h2 id="gowns-title" class="h2">The {d.name} <em>edit</em></h2>
      <a class="btn" href="/book/" data-track="book_click" data-track-label={`designer_${d.slug}`}>Book an appointment <span class="arrow" aria-hidden="true"></span></a>
    </div>
    <ul class="g-grid" role="list">
      {list.map((g, i) => <li data-reveal style={`--d:${(i % 4) * 0.06}s`}><GownCard gown={g} sizes="(min-width: 1100px) 23vw, (min-width: 700px) 31vw, 46vw" /></li>)}
    </ul>
  </section>

  <nav class="wrap next-house" aria-label="Next designer">
    <a href={`/designers/${next.slug}/`}>
      <span class="caps muted">Next house</span>
      <span class="display">{next.name}</span>
    </a>
  </nav>

  <FinalCTA image={d.feature[0]} lines={[`Try ${d.name}`, '<em>in person.</em>']} pos="50% 25%" />
</Base>

<style is:global>
  .d-intro { align-items: start; row-gap: 3rem; }
  .di-copy { grid-column: 1 / span 7; display: grid; gap: 1.75rem; }
  .d-lead { font-size: clamp(1.6rem, 2.6vw, 2.5rem); line-height: 1.3; }
  .di-facts { grid-column: 9 / -1; border-top: 1px solid var(--line); }
  .di-facts div { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .di-facts dt { font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .di-facts dd { margin: 0; font-family: var(--serif); font-size: 1.15rem; text-align: right; }
  @media (max-width: 900px) { .di-copy, .di-facts { grid-column: 1 / -1; } }
  .d-editorial { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(.75rem, 1.5vw, 1.5rem); }
  .d-editorial figure { margin: 0; aspect-ratio: 2/3; }
  .de-0 { grid-column: 1 / span 5; }
  .de-1 { grid-column: 6 / span 4; margin-top: 6rem !important; }
  .de-2 { grid-column: 10 / span 3; margin-top: 2rem !important; }
  @media (max-width: 700px) { .de-0 { grid-column: 1 / span 7; } .de-1 { grid-column: 8 / span 5; margin-top: 3rem !important; } .de-2 { display: none; } }
  .g-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 3rem; }
  .g-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3rem clamp(1rem, 2vw, 2rem); }
  @media (max-width: 1100px) { .g-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .g-grid { grid-template-columns: 1fr 1fr; } }
  .next-house { padding-bottom: var(--section-sm); }
  .next-house a { display: grid; gap: .75rem; text-decoration: none; border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .next-house .display { font-size: clamp(2.6rem, 7vw, 7rem); transition: padding .6s var(--ease); }
  .next-house a:hover .display { font-style: italic; padding-left: 1rem; }
</style>
