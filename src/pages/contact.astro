---
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Pic from '../components/Pic.astro';
import { site } from '../data/site.js';
---
<Base
  title="Visit the Boutique | Richland, near Kalamazoo"
  description="Visit La Soirée Bridal at 8880 N 32nd Street, Richland, MI — minutes from Kalamazoo, about an hour from Grand Rapids. By appointment."
  image="s/boutique-salon"
>
  <section class="page-intro wrap">
    <p class="eyebrow" data-reveal>Visit</p>
    <Lines tag="h1" lines={['Find us in', '<em>Richland.</em>']} delay={0.1} />
  </section>

  <section class="wrap grid-12 visit">
    <div class="visit-info">
      <div class="block" data-reveal>
        <h2 class="caps">The boutique</h2>
        <address>{site.address.street}, <span style="white-space:nowrap">{site.address.suite}</span><br />{site.address.city}, {site.address.regionLong} {site.address.zip}</address>
        <a class="link" href={site.mapsUrl} target="_blank" rel="noopener">Get directions<span class="sr-only"> (opens Google Maps)</span></a>
      </div>
      <div class="block" data-reveal style="--d:.06s">
        <h2 class="caps">Getting here</h2>
        <p class="muted">Northeast of Kalamazoo, a short drive from Portage, Battle Creek and Plainwell, and about an hour from Grand Rapids.</p>
      </div>
      <div class="block" data-reveal style="--d:.12s">
        <h2 class="caps">Appointment hours</h2>
        <dl class="hours">
          {site.hours.map((h) => <div><dt>{h.label}</dt><dd>{h.time}</dd></div>)}
        </dl>
        <p class="small muted">Open by appointment only.</p>
      </div>
      <div class="block" data-reveal style="--d:.18s">
        <h2 class="caps">Talk to us</h2>
        <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>

    <div class="visit-form">
      <figure class="media visit-img" data-reveal="mask"><Pic k="s/boutique-salon" alt="Inside La Soirée Bridal" sizes="(min-width: 900px) 50vw, 100vw" /></figure>
      <form name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company" class="form-grid" data-reveal>
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="full"><h2 class="h3">Send a note</h2><p class="muted small" style="margin-top:.5rem">Questions about gowns, sizing or a special request — we’ll reply by email.</p></div>
        <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="c-phone">Phone <span class="muted">(optional)</span></label><input id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="field"><label for="c-date">Wedding date <span class="muted">(optional)</span></label><input id="c-date" name="wedding_date" type="date" /></div>
        <div class="field full"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required></textarea></div>
        <div class="full btn-row"><button class="btn" type="submit">Send message <span class="arrow" aria-hidden="true"></span></button><a class="link" href="/book/">Or book directly</a></div>
        <p class="full small muted">We use your details only to reply. <a href="/privacy/">Privacy</a></p>
      </form>
    </div>
  </section>

  <section class="section-sm"></section>
</Base>

<style is:global>
  .visit { row-gap: 3rem; align-items: start; }
  .visit-info { grid-column: 1 / span 4; display: grid; gap: 2.25rem; }
  .block { border-top: 1px solid var(--line); padding-top: 1.25rem; display: grid; gap: .75rem; justify-items: start; }
  .block h2 { font-family: var(--sans); color: var(--brass-text); }
  .visit address { font-style: normal; font-family: var(--serif); font-size: 1.5rem; line-height: 1.3; }
  .block a:not(.link) { color: var(--ink); }
  .hours { display: grid; gap: .3rem; width: 100%; }
  .hours div { display: flex; justify-content: space-between; gap: 1rem; font-size: .95rem; }
  .hours dt { color: var(--muted); }
  .hours dd { margin: 0; }
  .visit-form { grid-column: 6 / -1; display: grid; gap: 3rem; }
  .visit-img { aspect-ratio: 16/10; }
  @media (max-width: 900px) { .visit-info, .visit-form { grid-column: 1 / -1; } }
</style>
