---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Thank you for contacting La Soirée Bridal." noindex>
  <section class="wrap center" style="min-height:80svh; display:grid; place-content:center; gap:2rem; padding-top:var(--header-h)">
    <p class="eyebrow">Message received</p>
    <h1 class="display">Thank <em>you.</em></h1>
    <p class="lede">We’ll reply by email soon. In the meantime, you can reserve your appointment online.</p>
    <div class="btn-row" style="justify-content:center"><a class="btn" href="/book/">Book an appointment</a><a class="link" href="/collection/">Browse the collection</a></div>
  </section>
</Base>
