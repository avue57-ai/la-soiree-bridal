---
import Pic from '../../components/Pic.astro';
import Lines from '../../components/Lines.astro';
import { em } from '../../lib/text.js';
const { s } = Astro.props;
---
<section class="section vip-teaser on-dark" aria-labelledby="vip-title">
  <div class="vip-bg" aria-hidden="true"><Pic k={s.backgroundImage.key} alt="" sizes="100vw" /></div>
  <div class="wrap grid-12 vt-grid">
    <div class="vt-text">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <Lines id="vip-title" class="display" lines={s.headline.map(em)} />
      <p class="lede" data-reveal style="--d:.2s">{s.lede}</p>
      <dl class="vip-facts" data-reveal style="--d:.3s">
        {s.facts.map((f) => <div><dt>{f.term}</dt><dd>{f.detail}</dd></div>)}
      </dl>
      <div class="btn-row" data-reveal style="--d:.4s">
        <a class="btn btn-light" href={s.cta.href}>{s.cta.label} <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
    <figure class="vt-img media" data-reveal="mask">
      <Pic k={s.image.key} alt={s.image.alt} sizes="(min-width: 900px) 34vw, 90vw" />
    </figure>
  </div>
</section>
