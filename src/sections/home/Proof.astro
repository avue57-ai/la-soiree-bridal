---
import Pic from '../../components/Pic.astro';
import { testimonials } from '../../data/testimonials.js';
import { site } from '../../data/site.js';
const { s } = Astro.props;
---
<section class="section proof" aria-labelledby="proof-title">
  <div class="wrap grid-12">
    <figure class="proof-img media" data-reveal="mask">
      <Pic k={s.image.key} alt={s.image.alt} sizes="(min-width: 900px) 45vw, 100vw" pos={s.image.pos} />
    </figure>
    <div class="proof-text">
      <p class="eyebrow" data-reveal>{s.eyebrow}</p>
      <h2 id="proof-title" class="sr-only">{s.srHeading}</h2>
      <div class="quotes" data-quotes>
        {testimonials.map((t, i) => (
          <figure class="quote" data-reveal style={`--d:${i * 0.12}s`}>
            <blockquote class="serif">“{t.quote}”</blockquote>
            <figcaption class="caps muted">{t.name} · {t.source}</figcaption>
          </figure>
        ))}
      </div>
      <a class="link" href={site.social.instagram} target="_blank" rel="noopener" data-reveal>{s.instagramLabel} · {site.social.instagramHandle}<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </div>
</section>
