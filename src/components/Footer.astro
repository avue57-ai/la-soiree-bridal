---
import { site, navigationData as navigation } from '../data/site.js';
import Wordmark from './Wordmark.astro';
import Social from './Social.astro';
const year = new Date().getFullYear();
const foot = navigation.footer;
---
<footer class="site-footer on-dark" data-hide-bookbar>
  <div class="wrap footer-top">
    <div class="footer-brand">
      <Wordmark />
      <p>{foot.tagline}</p>
      <Social />
    </div>
    <div>
      <h2>Visit</h2>
      <address style="font-style:normal; line-height:1.8">
        {site.address.street}, <span style="white-space:nowrap">{site.address.suite}</span><br />
        {site.address.city}, {site.address.regionLong} {site.address.zip}
      </address>
      <p style="margin-top:.8rem">By appointment only</p>
      <p style="margin-top:.8rem"><a href={site.mapsUrl} rel="noopener" target="_blank">Get directions<span class="sr-only"> (opens Google Maps)</span></a></p>
    </div>
    {foot.columns.map((col) => (
      <div>
        <h2>{col.title}</h2>
        <ul role="list">
          {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {col.withContact && <li><a href={site.phoneHref}>{site.phone}</a></li>}
          {col.withContact && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap footer-bottom">
    <span>{foot.bottomLine.replace('{year}', String(year))}</span>
    <span>{foot.legal.map((l) => <a href={l.href}>{l.label}</a>)}</span>
  </div>
</footer>
