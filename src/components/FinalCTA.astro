---
import Pic from './Pic.astro';
import Lines from './Lines.astro';
import { site } from '../data/site.js';
import { ratio } from '../lib/img.js';
interface Props { image?: string; lines?: string[]; pos?: string; eyebrow?: string; primaryCta?: { label: string; href: string; track?: string }; secondaryCta?: { label: string; href: string } }
const { image = 'g/anna-sposa--maritam--0', lines = ['Your dress', 'is <em>waiting.</em>'], pos = '50% 30%', eyebrow = 'Open by appointment', primaryCta = { label: 'Book your appointment', href: '/book/', track: 'final_cta' }, secondaryCta = { label: 'Ask us a question', href: '/contact/' } } = Astro.props;
const split = ratio(image) < 1.1; // portrait imagery sits beside the copy instead of under it
---
<section class:list={['final-cta on-dark', { split }]} aria-labelledby="final-cta-title" data-hide-bookbar>
  <div class="media fc-media"><Pic k={image} alt="" sizes={split ? '(min-width: 900px) 45vw, 100vw' : '100vw'} pos={pos} imgClass="fc-img" /></div>
  <div class="wrap fc-content">
    <p class="eyebrow">{eyebrow}</p>
    <Lines lines={lines} class="display" id="final-cta-title" />
    <div class="btn-row" data-reveal style="--d:.3s">
      <a class="btn btn-light" href={primaryCta.href} data-track={primaryCta.track ? 'book_click' : undefined} data-track-label={primaryCta.track}>{primaryCta.label} <span class="arrow" aria-hidden="true"></span></a>
      <a class="link" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
    <p class="fc-address small" data-reveal style="--d:.45s">{site.address.street}, {site.address.suite} · {site.address.city}, {site.address.regionLong} · <a href={site.mapsUrl} target="_blank" rel="noopener">Directions</a></p>
  </div>
</section>
