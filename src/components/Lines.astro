---
// Headline split into masked lines that rise into view. Pass lines as an array; each may contain <em>.
interface Props { lines: string[]; tag?: string; class?: string; delay?: number; id?: string }
const { lines, tag: Tag = 'h2', class: cls, delay = 0, id } = Astro.props;
---
<Tag class={cls} id={id} style={`--d:${delay}s`}>
  {lines.map((l, i) => <span class="split-line" style={`--i:${i}`}><span set:html={l} /></span>)}
</Tag>
